{
  "expo": {
    "name": "SolveLock",
    "slug": "solvelock",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "solvelock",
    "userInterfaceStyle": "automatic",
    "ios": {
      "appleTeamId": "37U34B89DU",
      "supportsTablet": true,
      "bundleIdentifier": "com.ramko9999.solvelock",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      [
        "react-native-device-activity",
        {
          "appleTeamId": "37U34B89DU",
          "appGroup": "group.com.ramko9999.solvelock"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "CHANGEME_AFTER_EAS_INIT"
      }
    }
  }
}
